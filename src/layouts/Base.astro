---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/jost/wght.css';
import '../styles/global.css';
import Tokens from '../components/Tokens.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absUrl, url, infos, SITE_ENV, jsonLdInstitut } from '../lib/site';

interface Props {
  titre: string;          // titre de la page (le nom de l'institut est ajouté)
  description: string;    // 120-160 caractères, unique par page
  image?: string;         // image Open Graph absolue (sinon og.jpg)
  jsonLd?: object[];      // données structurées en plus de la fiche institut
  fil?: { nom: string; path: string }[]; // fil d'Ariane
}
const { titre, description, image, jsonLd = [], fil } = Astro.props;
const pageTitle = titre === infos.nom ? `${infos.nom} · Institut de beauté à Broc, Gruyère` : `${titre} · ${infos.nom}, Broc`;
const canonical = absUrl(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/');
const ogImage = image ?? absUrl('/og.jpg');
const ld = [jsonLdInstitut(), ...jsonLd];
if (fil) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ nom: 'Accueil', path: '/' }, ...fil].map((f, i) => ({
      '@type': 'ListItem', position: i + 1, name: f.nom, item: absUrl(f.path),
    })),
  });
}
---
<!doctype html>
<html lang="fr-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {SITE_ENV !== 'prd' && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1c1633" />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content={infos.nom} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <Tokens />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    {SITE_ENV === 'qua' && <div class="bandeau-test">Version de test · pas encore en ligne</div>}
    <Header />
    <main id="contenu">
      {fil && (
        <nav class="fil" aria-label="Fil d'Ariane">
          <a href={url('/')}>Accueil</a>
          {fil.map((f, i) => i < fil.length - 1 ? <><span aria-hidden="true">›</span><a href={url(f.path)}>{f.nom}</a></> : <><span aria-hidden="true">›</span><span aria-current="page">{f.nom}</span></>)}
        </nav>
      )}
      <slot />
    </main>
    <Footer />
  </body>
</html>
