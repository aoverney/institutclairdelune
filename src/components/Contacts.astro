---
import { infos } from '../lib/site';
const ico = {
  tel: '<path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/>',
  wa: '<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3 .78.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.55.12-.16.25-.63.8-.78.97-.14.16-.29.18-.54.06a6.7 6.7 0 0 1-3.3-2.88c-.25-.43.25-.4.7-1.33.08-.16.04-.3-.02-.42l-.75-1.8c-.2-.48-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.3 2.7 2.7 0 0 0-.85 2.02 4.7 4.7 0 0 0 1 2.5 10.8 10.8 0 0 0 4.13 3.65c1.54.66 2.14.72 2.9.6.48-.07 1.46-.6 1.66-1.17.2-.58.2-1.07.14-1.17-.06-.1-.22-.16-.47-.28z"/>',
  mail: '<path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm8 7.2L19 7.5V7H5v.5zM5 9.9V17h14V9.9l-7 4.6z"/>',
  fb: '<path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.25-1.5 1.55-1.5h1.65V4.45A22 22 0 0 0 14.3 4.3c-2.4 0-4 1.45-4 4.1v2.4H7.6V14h2.7v8z"/>',
  lieu: '<path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/>',
};
const [u, d] = infos.email.split('@');
const enc = (s: string) => [...s].reverse().join('');
const a = infos.adresse;
const carte = `https://www.openstreetmap.org/search?query=${encodeURIComponent(`${a.rue}, ${a.npa} ${a.localite}`)}`;
const svg = (p: string) => `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">${p}</svg>`;
---
<div class="contacts">
  <a class="contact" href={`tel:${infos.telephoneInternational}`}>
    <Fragment set:html={svg(ico.tel)} />
    <span><strong>Appeler</strong>{infos.telephone}</span>
  </a>
  <a class="contact" href={`https://wa.me/${infos.whatsapp}`} rel="noopener">
    <Fragment set:html={svg(ico.wa)} />
    <span><strong>WhatsApp</strong>Écrire un message</span>
  </a>
  <a class="contact js-email" data-u={enc(u)} data-d={enc(d)} data-label="" href="#">
    <Fragment set:html={svg(ico.mail)} />
    <span><strong>Email</strong><span class="js-email__txt">Écrire un email</span></span>
  </a>
  <a class="contact" href={infos.facebook} rel="noopener">
    <Fragment set:html={svg(ico.fb)} />
    <span><strong>Facebook</strong>Suivre l'institut</span>
  </a>
  <a class="contact" href={carte} rel="noopener">
    <Fragment set:html={svg(ico.lieu)} />
    <span><strong>Adresse</strong>{a.rue}, {a.npa} {a.localite}</span>
  </a>
</div>
