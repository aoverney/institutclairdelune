---
import { url } from '../lib/site';
---
<section class="section ciel">
  <div class="etroit">
    <div class="cartouche">
      <p class="surtitre">Sur rendez-vous</p>
      <h2>Offrez-vous un moment pour vous</h2>
      <p>Appelez-moi, écrivez-moi sur WhatsApp ou par email : je vous réponds avec plaisir.</p>
      <div class="boutons" style="justify-content:center">
        <a class="bouton" href={url('/contactez-moi/')}>Prendre rendez-vous</a>
        <a class="bouton bouton--clair" href={url('/catalogue-soins/')}>Voir les tarifs</a>
      </div>
    </div>
  </div>
</section>
